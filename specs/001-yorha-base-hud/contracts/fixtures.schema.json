{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rien-os/shell/fixtures/1",
  "title": "HUD test data (every domain is optional; a missing domain means real data)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "clock": { "type": "string", "format": "date-time", "description": "Fixed local time, e.g. 2026-10-26T13:37:00" },
    "cpu": { "type": "number", "minimum": 0, "maximum": 100 },
    "mem": { "type": "number", "minimum": 0, "maximum": 100 },
    "volume": {
      "type": "object", "additionalProperties": false,
      "properties": { "percent": { "type": "number", "minimum": 0, "maximum": 100 }, "muted": { "type": "boolean" } },
      "required": ["percent"]
    },
    "battery": {
      "oneOf": [
        { "type": "null", "description": "No battery: the reading disappears" },
        {
          "type": "object", "additionalProperties": false,
          "properties": { "percent": { "type": "number", "minimum": 0, "maximum": 100 }, "charging": { "type": "boolean" } },
          "required": ["percent"]
        }
      ]
    },
    "workspaces": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "existing": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
        "focused": { "type": "integer", "minimum": 1 }
      },
      "required": ["existing", "focused"]
    },
    "activeWindow": { "type": "string", "description": "Empty string = no active window" },
    "settings": { "type": "string", "description": "Caminho de outro catálogo de configurações (spec 003)" },
    "wallpaper": {
      "type": "object", "additionalProperties": false,
      "description": "Spec 004 (data-model, 'Fixture'): a pasta de imagens (relativa ao shell/), a escolha e a transição; com ele nada é escrito no estado e as trocas são instantâneas",
      "properties": {
        "folder": { "type": "string" },
        "all": { "type": "string", "description": "Id do papel de parede de todos os monitores (scene:menu, image:<caminho>)" },
        "monitors": { "type": "object", "additionalProperties": { "type": "string" } },
        "transition": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "kind": { "enum": ["camouflage", "wipe", "tiles", "crossfade"] },
            "cell": { "enum": [16, 24, 32] },
            "trail": { "type": "integer", "minimum": 400, "maximum": 4000 },
            "glitch": { "enum": [0, 1, 2] }
          }
        }
      }
    }
  }
}
