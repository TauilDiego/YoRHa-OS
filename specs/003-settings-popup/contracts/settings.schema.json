{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "yorha-os/settings-catalog",
  "title": "Catálogo das configurações (spec 003, FR-019)",
  "description": "shell/fixtures/settings-default.json. Os textos vêm em inglês e aparecem como estão.",
  "type": "object",
  "required": [
    "categories"
  ],
  "additionalProperties": false,
  "properties": {
    "needs": {
      "description": "Mensagem mostrada no quadro quando uma opção depende de um liga/desliga desligado. Chave = o `key` do liga/desliga.",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "about",
          "options"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "label": {
            "type": "string"
          },
          "about": {
            "type": "string",
            "description": "Frase do quadro com o foco na categoria"
          },
          "options": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/option"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "option": {
      "type": "object",
      "required": [
        "id",
        "label",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "label": {
          "type": "string"
        },
        "type": {
          "enum": [
            "toggle",
            "choice",
            "slider",
            "action",
            "info",
            "multi"
          ]
        },
        "desc": {
          "type": "string"
        },
        "key": {
          "type": "string",
          "description": "Só em toggle: nome que outras opções usam em `needs`"
        },
        "needs": {
          "type": "string",
          "description": "Fica apagada quando o toggle com esse `key` está desligado"
        },
        "value": {
          "description": "toggle: boolean; choice: índice em `values`; slider: 0–100"
        },
        "default": {
          "description": "Mesmo tipo de `value`"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "description": "Só em choice"
        },
        "ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "description": "Em choice, opcional (spec 007); em multi (spec 013), obrigatório: o nome XKB de cada layout: um id estável por valor, do mesmo tamanho de `values`; o código lê o valor em uso por SettingsModel.choiceId"
        },
        "step": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "description": "Só em slider"
        },
        "text": {
          "type": "string",
          "description": "action: rótulo (Search, Set up, Open); info: o texto mostrado"
        },
        "busy": {
          "type": "string",
          "description": "Só em action: aviso mostrado no quadro por motion.actionBusy"
        },
        "setting": {
          "type": "string",
          "description": "Spec 013: também em multi (lista de marcas, valor = índices marcados; `input.kbLayouts`). Spec 004, emenda (2): só em choice. Liga a opção a uma configuração do shell (Settings): `values` na ordem dos níveis dela (barContrast: normal, high); o valor vem da configuração, a troca vale na hora e é salva no estado (\"shell.<key>\"). Spec 019: `sys.<provedor>.<chave>` liga a linha a um provedor do sistema (contracts/system-provider.md da 019): choice, slider, toggle ou info, sem value, values nem default; e `shell.uiScale`/`shell.barHeight`, de tipo levels, são choice sem values, value nem default"
        },
        "persist": {
          "type": "boolean",
          "default": true,
          "description": "Spec 004, emenda (3): false = o valor não é salvo no estado (volta ao do catálogo quando o shell reinicia). Padrão: salvar sempre"
        },
        "requires": {
          "type": "string",
          "description": "Spec 019 (FR-045): capacidade do compositor; sem ela, a linha some"
        },
        "opens": {
          "type": "string",
          "pattern": "^sys\\.[a-z]+\\.[A-Za-z0-9_-]+$",
          "description": "Spec 019: só em action; a lista desse provedor abre na janelinha, só leitura"
        }
      },
      "allOf": [
        {
          "if": {
            "allOf": [
              {
                "properties": {
                  "type": {
                    "const": "toggle"
                  }
                }
              },
              {
                "not": {
                  "anyOf": [
                    {
                      "properties": {
                        "setting": {
                          "type": "string",
                          "pattern": "^sys\\."
                        }
                      },
                      "required": [
                        "setting"
                      ]
                    },
                    {
                      "properties": {
                        "setting": {
                          "enum": [
                            "shell.uiScale",
                            "shell.barHeight"
                          ]
                        }
                      },
                      "required": [
                        "setting"
                      ]
                    }
                  ]
                }
              }
            ]
          },
          "then": {
            "required": [
              "value",
              "default"
            ],
            "properties": {
              "value": {
                "type": "boolean"
              },
              "default": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "allOf": [
              {
                "properties": {
                  "type": {
                    "const": "choice"
                  }
                }
              },
              {
                "not": {
                  "anyOf": [
                    {
                      "properties": {
                        "setting": {
                          "type": "string",
                          "pattern": "^sys\\."
                        }
                      },
                      "required": [
                        "setting"
                      ]
                    },
                    {
                      "properties": {
                        "setting": {
                          "enum": [
                            "shell.uiScale",
                            "shell.barHeight"
                          ]
                        }
                      },
                      "required": [
                        "setting"
                      ]
                    }
                  ]
                }
              }
            ]
          },
          "then": {
            "required": [
              "values",
              "value",
              "default"
            ],
            "properties": {
              "value": {
                "type": "integer",
                "minimum": 0
              },
              "default": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        {
          "if": {
            "allOf": [
              {
                "properties": {
                  "type": {
                    "const": "slider"
                  }
                }
              },
              {
                "not": {
                  "anyOf": [
                    {
                      "properties": {
                        "setting": {
                          "type": "string",
                          "pattern": "^sys\\."
                        }
                      },
                      "required": [
                        "setting"
                      ]
                    },
                    {
                      "properties": {
                        "setting": {
                          "enum": [
                            "shell.uiScale",
                            "shell.barHeight"
                          ]
                        }
                      },
                      "required": [
                        "setting"
                      ]
                    }
                  ]
                }
              }
            ]
          },
          "then": {
            "required": [
              "value",
              "default",
              "step"
            ],
            "properties": {
              "value": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "default": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "action"
              }
            }
          },
          "then": {
            "required": [
              "text",
              "busy"
            ]
          }
        },
        {
          "if": {
            "allOf": [
              {
                "properties": {
                  "type": {
                    "const": "info"
                  }
                }
              },
              {
                "not": {
                  "properties": {
                    "setting": {
                      "type": "string",
                      "pattern": "^sys\\."
                    }
                  },
                  "required": [
                    "setting"
                  ]
                }
              }
            ]
          },
          "then": {
            "required": [
              "text"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "setting": {
                "type": "string",
                "pattern": "^sys\\."
              }
            },
            "required": [
              "setting"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "enum": [
                  "choice",
                  "slider",
                  "toggle",
                  "info"
                ]
              },
              "value": false,
              "values": false,
              "default": false
            }
          }
        },
        {
          "if": {
            "allOf": [
              {
                "properties": {
                  "setting": {
                    "type": "string",
                    "pattern": "^sys\\."
                  }
                },
                "required": [
                  "setting"
                ]
              },
              {
                "properties": {
                  "type": {
                    "const": "slider"
                  }
                }
              }
            ]
          },
          "then": {
            "required": [
              "step"
            ]
          }
        },
        {
          "if": {
            "required": [
              "opens"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "const": "action"
              }
            }
          }
        },
        {
          "if": {
            "not": {
              "properties": {
                "setting": {
                  "type": "string",
                  "pattern": "^notify\\."
                }
              },
              "required": [
                "setting"
              ]
            }
          },
          "then": {
            "required": [
              "desc"
            ]
          }
        }
      ]
    }
  }
}
