#!/usr/bin/env bash
# yorha: install, update and run the YoRHa-OS shell (spec 014, contracts/cli.md). Method D of spec
# 005: each version lives in $YORHA_HOME/versions/<v>; "current" is a symlink switched atomically.
# Runs as the person; root only through sudo, after a yes.
set -euo pipefail
YORHA_ROOT=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
source "$YORHA_ROOT/lib/yorha/name.sh"
source "$YORHA_ROOT/lib/yorha/common.sh"
source "$YORHA_ROOT/lib/yorha/deps.sh"
[[ $EUID -ne 0 ]] || yorha_fail "run as your user, not root"

usage() {
    cat >&2 <<USAGE
usage: $YORHA_CMD version | status | update [--check [--json]] | rollback | migrate
       $YORHA_CMD shell start|restart | ipc <args…> | boot-login install|uninstall|status | uninstall
USAGE
    exit 2
}

cmd_status() {
    local cur prev channel running
    cur=$(yorha_current)
    prev=$(cat "$YORHA_HOME/previous" 2>/dev/null || true)
    channel=$(cat "$YORHA_HOME/channel" 2>/dev/null || true)
    [[ -s $(run_dir)/shell.pid ]] && running="yes (pid $(cat "$(run_dir)/shell.pid"))" || running=no
    printf '%s %s\n' "$YORHA_PRETTY" "${cur:-not installed}"
    printf '  previous:  %s\n' "${prev:-none}"
    printf '  channel:   %s\n' "${channel:-none}"
    printf '  folder:    %s\n' "$YORHA_HOME"
    printf '  shell:     %s\n' "$running"
}

# --- the shell (research R4) ------------------------------------------------------------------------
run_dir() { printf '%s/%s' "${XDG_RUNTIME_DIR:-/tmp}" "$YORHA_NAME"; }
shell_root() { readlink -f "$YORHA_HOME/current"; }

# Supervise qs on the version in use: one instance (a lock), restarted when it exits, so that
# `shell restart` (and an update) bring up whatever "current" points at. Stops when uninstalled.
# --relaunch: the same supervisor, re-executed from a newer version (it keeps the lock on fd 9).
cmd_shell_start() {
    local rd root qspid log
    rd=$(run_dir); mkdir -p "$rd" "$YORHA_STATE"
    if [[ ${1:-} != --relaunch ]]; then
        exec 9>"$rd/shell.lock"
        flock -n 9 || { yorha_say "the shell is already running"; exit 0; }
        # Qt registers with the portal at start; wait for it (at most 30 s), as the lab's runner does.
        timeout 30 systemctl --user start xdg-desktop-portal.service >/dev/null 2>&1 || true
        for _ in $(seq 60); do busctl --user status org.freedesktop.portal.Desktop >/dev/null 2>&1 && break; sleep 0.5; done
    fi
    # Two known Qt 6.12 warnings that are not ours (see lab/guest/nier-ui-run).
    export QT_LOGGING_RULES="qt.qpa.wayland.textinput.warning=false;qt.qpa.services.warning=false"
    log="$YORHA_STATE/shell.log"
    while [[ -L $YORHA_HOME/current ]]; do
        root=$(shell_root)
        # A newer version took over: run its own supervisor (its code may differ from this one's).
        if [[ $root != "$YORHA_ROOT" && -x $root/bin/$YORHA_CMD ]]; then
            exec "$root/bin/$YORHA_CMD" shell start --relaunch
        fi
        [[ -s $log ]] && mv -f "$log" "$log.1"     # the previous run, kept once
        YORHA_OS_ROOT="$root" qs -p "$root/shell" >>"$log" 2>&1 &
        qspid=$!
        echo "$qspid" > "$rd/shell.pid"
        wait "$qspid" || true
        rm -f "$rd/shell.pid"
        sleep 1
    done
    yorha_say "not installed anymore; the shell stays off"
}

# Stop the running qs; the supervisor brings the version in use back up.
cmd_shell_restart() {
    local pid
    pid=$(cat "$(run_dir)/shell.pid" 2>/dev/null || true)
    if [[ -n $pid ]] && kill "$pid" 2>/dev/null; then yorha_say "shell restarting"
    else yorha_say "the shell is not running (start it with: $YORHA_CMD shell start)"; fi
}

# The shell's IPC, on the same path the supervisor used (so qs finds the instance).
cmd_ipc() {
    [[ -L $YORHA_HOME/current ]] || yorha_fail "not installed"
    exec qs -p "$(shell_root)/shell" ipc call "$@"
}

# The line the person adds at the top of ~/.config/hypr/hyprland.lua (contracts/encaixe.md).
include_line() {
    local f="$YORHA_HOME/current/system/hypr/$YORHA_NAME.lua"
    if [[ $f == "$HOME"/* ]]; then
        printf 'pcall(dofile, os.getenv("HOME") .. "%s")\n' "${f#"$HOME"}"
    else
        printf 'pcall(dofile, "%s")\n' "$f"
    fi
}

# Called by install.sh from the freshly unpacked version: make it the one in use.
cmd__install() {
    local v
    v=$(yorha_version_of "$YORHA_ROOT")
    yorha_switch "$v"
    yorha_mark_migrations "$YORHA_ROOT"
    mkdir -p "$YORHA_STATE"
    echo "$v" > "$YORHA_STATE/last-version"
    yorha_say "$YORHA_PRETTY $v installed in $YORHA_HOME"
    if pgrep -x qs >/dev/null || pgrep -f serpantinumd >/dev/null; then
        yorha_say "another shell is running now; keep only one of them in your Hyprland autostart"
    fi
    case :$PATH: in *":$YORHA_BIN:"*) ;; *) yorha_say "add $YORHA_BIN to your PATH to run $YORHA_CMD" ;; esac
    cat <<DONE

Last step: add this line at the top of ~/.config/hypr/hyprland.lua, then log in again:

    $(include_line)

It starts the shell and adds its keys (SUPER; set YORHA_MOD = "ALT" on the line before to change).
To get newer versions later: $YORHA_CMD update
DONE
}

main() {
    case ${1:-} in
        version) echo "$YORHA_NAME $(yorha_version_of "$YORHA_ROOT")" ;;
        status) cmd_status ;;
        _install) cmd__install ;;
        shell)
            case ${2:-} in
                start) shift 2; cmd_shell_start "$@" ;;
                restart) cmd_shell_restart ;;
                *) usage ;;
            esac ;;
        ipc) shift; (($#)) || usage; cmd_ipc "$@" ;;
        *) usage ;;
    esac
}
main "$@"
