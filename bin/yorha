#!/usr/bin/env bash
# yorha: install, update and run the YoRHa-Shell shell (spec 014, contracts/cli.md). Method D of spec
# 005: each version lives in $YORHA_HOME/versions/<v>; "current" is a symlink switched atomically.
# Runs as the person; root only through sudo, after a yes.
set -euo pipefail
YORHA_ROOT=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
source "$YORHA_ROOT/lib/yorha/name.sh"
source "$YORHA_ROOT/lib/yorha/common.sh"
source "$YORHA_ROOT/lib/yorha/deps.sh"
source "$YORHA_ROOT/lib/yorha/channel.sh"
source "$YORHA_ROOT/lib/yorha/rename.sh"
[[ $EUID -ne 0 ]] || yorha_fail "run as your user, not root"

usage() {
    cat >&2 <<USAGE
usage: $YORHA_CMD version | status | update [--check [--json]] | rollback | migrate
       $YORHA_CMD shell start|restart | ipc <args…> | boot-login install|uninstall|status | uninstall
USAGE
    exit 2
}

cmd_status() {
    local cur prev channel running
    cur=$(yorha_current)
    prev=$(cat "$YORHA_HOME/previous" 2>/dev/null || true)
    channel=$(yorha_channel)
    [[ -s $(run_dir)/shell.pid ]] && running="yes (pid $(cat "$(run_dir)/shell.pid"))" || running=no
    printf '%s %s\n' "$YORHA_PRETTY" "${cur:-not installed}"
    printf '  previous:  %s\n' "${prev:-none}"
    printf '  channel:   %s\n' "${channel:-none}"
    printf '  folder:    %s\n' "$YORHA_HOME"
    printf '  shell:     %s\n' "$running"
    # spec 015 T022 (front C): after a change of name, the new hyprland.lua line.
    if has_include_line; then yorha_rename_status 0; else yorha_rename_status 1; fi
}

# --- versions (US2, research R2; spec 015: the channel core in lib/yorha/channel.sh) --------------
# The update is three steps, each its own function (spec 015, T009): update_check asks the channel,
# update_fetch brings a version into versions/<v>, update_finish puts it in use.
# Test hook (the lab's check-014, SC-004): YORHA_TEST_STOP_AT=download|unpacked|switched kills the
# update right there, as a crash or a power cut would.
test_stop() { [[ ${YORHA_TEST_STOP_AT:-} == "$1" ]] && { yorha_say "test stop at $1"; kill -9 $$; }; return 0; }
is_newer() { [[ $1 != "$2" && $(printf '%s\n' "$1" "$2" | sort -V | tail -1) == "$1" ]]; }

# An update error: a line on stderr, or a JSON object with --json. $1 message, $2 exit code. Uses the
# caller's json and cur.
update_err() {
    if ((${json:-0})); then
        printf '{"current":"%s","channel":"%s","error":"%s"}\n' "${cur:-}" "$(yorha_channel)" "$1"
        exit "$2"
    fi
    yorha_fail "$1" "$2"
}

# The newest version of the channel: sets the caller's latest and origin (the origin that answered).
update_check() {
    local out
    out=$(yorha_latest) || update_err "no origin answered ($(yorha_origins | tr '\n' ' ' | sed 's/ $//')); nothing changed" 1
    latest=${out%% *}
    origin=${out#* }
}

# Download, check and prepare version $1 into versions/$1 (nothing in use is touched).
update_fetch() {
    local v=$1 dl tmp got pkg rc=0
    [[ -d $YORHA_HOME/versions/$v ]] && return 0
    dl="$YORHA_HOME/downloads/$v"      # a leftover of an interrupted update is redone
    rm -rf "$dl" && mkdir -p "$dl"
    yorha_say "downloading $v"
    got=$(yorha_fetch_release "$v" "$dl") || rc=$?
    case $rc in
        0) ;;
        4) rm -rf "$dl"; yorha_fail "checksum mismatch for $v; refusing, nothing changed" 4 ;;
        *) rm -rf "$dl"; yorha_fail "download of $v failed; nothing changed" ;;
    esac
    test_stop download
    tmp="$YORHA_HOME/versions/.$v.part"
    rm -rf "$tmp" && mkdir -p "$tmp"
    # The package the release's manifest names: it may carry another product name (then the
    # version's own lib/yorha/name.sh, and the third field of $got, say which).
    pkg=$(cut -d' ' -f2 <<<"$got")
    tar -xzf "$dl/$pkg" -C "$tmp" --strip-components=1
    yorha_deps_ensure "$tmp/system/deps" >/dev/null || yorha_say "a dependency of $v is missing (see: $YORHA_CMD status)"
    yorha_prepare "$tmp"
    test_stop unpacked
    mv -T "$tmp" "$YORHA_HOME/versions/$v"
    rm -rf "$dl"
}

# Put the fetched version $2 in use over $1: copy the state, switch, migrate, prune, restart the shell.
# Spec 015: only for a fetched version from before 015, which has no _finish-update (see update_handover).
update_finish() {
    local cur=$1 v=$2 new="$YORHA_HOME/versions/$2"
    yorha_backup_state "$cur" >/dev/null
    yorha_switch "$v"
    test_stop switched
    "$new/bin/$YORHA_CMD" migrate --from "$cur" || yorha_fail "the update to $v stopped at a migration; $YORHA_CMD rollback goes back to $cur" 5
    yorha_prune
    "$new/bin/$YORHA_CMD" shell restart >/dev/null || true
    yorha_say "updated to $v (previous: $cur; $YORHA_CMD rollback goes back)"
}

# Spec 015 (research R6): the fetched version $2 finishes the update itself (_finish-update), since
# only it knows its own name; the command is the one its own name.sh says.
update_handover() {
    local cur=$1 v=$2 new="$YORHA_HOME/versions/$2" cmd
    cmd=$(yorha_name_of "$new" | sed -n 2p)
    if [[ -n $cmd && -x $new/bin/$cmd ]] && grep -q '_finish-update' "$new/bin/$cmd"; then
        exec "$new/bin/$cmd" _finish-update --from "$cur" --from-home "$YORHA_HOME"
    fi
    update_finish "$cur" "$v"
}

# Stop the qs whose pid is in run folder $1 (default: this name's); the supervisor brings up the
# version in use, or follows a change of name.
stop_shell() {
    local pid
    pid=$(cat "${1:-$(run_dir)}/shell.pid" 2>/dev/null || true)
    [[ -n $pid ]] && kill "$pid" 2>/dev/null
}

# In the new version, called by the update of the version in use ($cur, installed in --from-home):
# change the name if this version has another one (lib/yorha/rename.sh), copy the state, switch,
# migrate, prune, restart the shell.
cmd__finish_update() {
    local cur="" from_home="" v rd renamed=0 o
    while (($#)); do
        case $1 in
            --from) cur=${2:?--from <version>}; shift ;;
            --from-home) from_home=${2:?--from-home <folder>}; shift ;;
            *) usage ;;
        esac
        shift
    done
    [[ -n $cur && -n $from_home ]] || usage
    v=$(yorha_version_of "$YORHA_ROOT")
    rd=$(run_dir)
    if [[ $from_home != "$YORHA_HOME" ]]; then
        mapfile -t o < <(yorha_name_of "$from_home/versions/$cur") || true
        ((${#o[@]} == 6)) || yorha_fail "cannot read the name of $from_home/versions/$cur; nothing changed" 1
        YORHA_STATE=${o[4]} yorha_backup_state "$cur" >/dev/null     # the state as it was, under the old name
        rd="${XDG_RUNTIME_DIR:-/tmp}/${o[0]}"                        # where the running shell is
        yorha_rename_forward "$from_home/versions/$cur"
        YORHA_ROOT="$YORHA_HOME/versions/$v"
        renamed=1
    else
        yorha_backup_state "$cur" >/dev/null
    fi
    yorha_switch "$v"
    test_stop switched
    yorha_migrate "$YORHA_ROOT" "$cur" || yorha_fail "the update to $v stopped at a migration; $YORHA_CMD rollback goes back to $cur" 5
    yorha_prune
    stop_shell "$rd" || true
    yorha_say "updated to $v (previous: $cur; $YORHA_CMD rollback goes back)"
    if ((renamed)); then if has_include_line; then yorha_rename_notes 0; else yorha_rename_notes 1; fi; fi
    return 0
}

cmd_update() {
    local check=0 json=0 latest="" origin="" cur a
    while (($#)); do
        case $1 in --check) check=1 ;; --json) json=1 ;; *) usage ;; esac
        shift
    done
    cur=$(yorha_current)
    [[ -n $cur ]] || update_err "not installed" 1
    update_check
    if ((check)); then
        if ((json)); then
            is_newer "$latest" "$cur" && a=true || a=false
            printf '{"current":"%s","latest":"%s","available":%s,"channel":"%s","origin":"%s"}\n' \
                "$cur" "$latest" "$a" "$(yorha_channel)" "$origin"
        else
            is_newer "$latest" "$cur" && echo "available $latest" || echo "up-to-date"
        fi
        return 0
    fi
    if ! is_newer "$latest" "$cur"; then
        # Nothing newer: finish what an interrupted update left (pending migrations, and a shell
        # still running an older version).
        "$YORHA_HOME/current/bin/$YORHA_CMD" migrate
        local running
        running=$(cat "$(run_dir)/shell.root" 2>/dev/null || true)
        if [[ -n $running && $running != "$(shell_root)" ]]; then
            "$YORHA_HOME/current/bin/$YORHA_CMD" shell restart >/dev/null || true
        fi
        yorha_prune
        yorha_say "up to date ($cur)"
        return 0
    fi
    update_fetch "$latest"
    update_handover "$cur" "$latest"
}

# Back to the version before the last update, with the state as it was before that update.
# Spec 015: when the previous version has another name, the name changes back first: the same move
# as an update's (lib/yorha/rename.sh), in the other direction, and the rest runs under that name.
cmd_rollback() {
    local cur prev state o rd from="" here
    cur=$(yorha_current)
    prev=$(cat "$YORHA_HOME/previous" 2>/dev/null || true)
    [[ -n $prev && -d $YORHA_HOME/versions/$prev ]] || yorha_fail "no previous version to go back to" 3
    rd=$(run_dir)
    mapfile -t o < <(yorha_name_of "$YORHA_HOME/versions/$prev") || true
    if ((${#o[@]} == 6)) && [[ ${o[0]} != "$YORHA_NAME" ]]; then
        here="$YORHA_HOME/versions/$cur"
        # From here on, the previous version's name.
        # shellcheck source=/dev/null
        source "$YORHA_HOME/versions/$prev/lib/yorha/name.sh"
        yorha_rename_forward "$here"
        from=$(cat "$YORHA_STATE/renamed-from")
    fi
    yorha_switch "$prev"
    rm -f "$YORHA_HOME/previous"
    if [[ -d $YORHA_STATE/backups/$prev ]]; then
        find "$YORHA_STATE" -mindepth 1 -maxdepth 1 ! -name backups -exec rm -rf {} +
        cp -a "$YORHA_STATE/backups/$prev/." "$YORHA_STATE/"
        state="state restored from before the update"
    else
        state="no copy of the state from $prev; state left as is"
    fi
    # The restored state is from before the change of name: say again where the name came from.
    [[ -n $from ]] && printf '%s\n' "$from" > "$YORHA_STATE/renamed-from"
    stop_shell "$rd" || true
    yorha_say "rolled back from $cur to $prev ($state)"
    if [[ -n $from ]]; then if has_include_line; then yorha_rename_notes 0; else yorha_rename_notes 1; fi; fi
    return 0
}

cmd_migrate() {
    local from
    from=$(cat "$YORHA_STATE/last-version" 2>/dev/null || echo unknown)
    [[ ${1:-} == --from ]] && from=${2:?--from <version>}
    yorha_migrate "$YORHA_ROOT" "$from"
}

# --- the shell (research R4) ------------------------------------------------------------------------
run_dir() { printf '%s/%s' "${XDG_RUNTIME_DIR:-/tmp}" "$YORHA_NAME"; }
shell_root() { readlink -f "$YORHA_HOME/current"; }

# Supervise qs on the version in use: one instance (a lock), restarted when it exits, so that
# `shell restart` (and an update) bring up whatever "current" points at. Stops when uninstalled.
# --relaunch: the same supervisor, re-executed from a newer version (it keeps the lock on fd 9).
cmd_shell_start() {
    local rd root qspid log to
    rd=$(run_dir); mkdir -p "$rd" "$YORHA_STATE"
    # Quickshell only watches the applications folder if it exists when it starts; without it, an app
    # installed later stays out of the APPS tab until a restart (spec 007, T041; PLAN, S3).
    mkdir -p "${XDG_DATA_HOME:-$HOME/.local/share}/applications"
    if [[ ${1:-} == --relaunch ]]; then
        # Followed a change of name (spec 015): hold the lock of this name's run folder instead. A
        # child that inherited the old lock may still hold this one; the relaunch goes on anyway.
        if [[ $(readlink "/proc/$$/fd/9" 2>/dev/null) != "$rd/shell.lock" ]]; then
            exec 9>"$rd/shell.lock"
            flock -n 9 || true
        fi
    else
        exec 9>"$rd/shell.lock"
        flock -n 9 || { yorha_say "the shell is already running"; exit 0; }
        # Qt registers with the portal at start; wait for it (at most 30 s), as the lab's runner does.
        timeout 30 systemctl --user start xdg-desktop-portal.service >/dev/null 2>&1 || true
        for _ in $(seq 60); do busctl --user status org.freedesktop.portal.Desktop >/dev/null 2>&1 && break; sleep 0.5; done
    fi
    # Two known Qt 6.12 warnings that are not ours (see lab/guest/nier-ui-run).
    export QT_LOGGING_RULES="qt.qpa.wayland.textinput.warning=false;qt.qpa.services.warning=false"
    log="$YORHA_STATE/shell.log"
    while :; do
        if [[ ! -L $YORHA_HOME/current ]]; then
            # A change of name (spec 015, research R6) moves this folder away and leaves renamed-to:
            # follow it to the new command instead of stopping, so the shell does not drop.
            for _ in $(seq 10); do [[ -L $YORHA_HOME/current || -s $YORHA_HOME/renamed-to ]] && break; sleep 0.5; done
            if [[ ! -L $YORHA_HOME/current ]]; then
                to=$(yorha_kv "$YORHA_HOME/renamed-to" bin || true)
                [[ -n $to && -x $to ]] && exec "$to" shell start --relaunch
                break
            fi
        fi
        root=$(shell_root)
        # A newer version took over: run its own supervisor (its code may differ from this one's).
        if [[ $root != "$YORHA_ROOT" && -x $root/bin/$YORHA_CMD ]]; then
            exec "$root/bin/$YORHA_CMD" shell start --relaunch
        fi
        [[ -s $log ]] && mv -f "$log" "$log.1"     # the previous run, kept once
        YORHA_ROOT="$root" YORHA_NAME="$YORHA_NAME" YORHA_CMD="$YORHA_CMD" YORHA_PRETTY="$YORHA_PRETTY" \
            qs -p "$root/shell" >>"$log" 2>&1 &
        qspid=$!
        echo "$qspid" > "$rd/shell.pid"
        echo "$root" > "$rd/shell.root"
        wait "$qspid" || true
        rm -f "$rd/shell.pid" "$rd/shell.root"
        sleep 1
    done
    yorha_say "not installed anymore; the shell stays off"
}

# Stop the running qs; the supervisor brings the version in use back up.
cmd_shell_restart() {
    local pid
    pid=$(cat "$(run_dir)/shell.pid" 2>/dev/null || true)
    if [[ -n $pid ]] && kill "$pid" 2>/dev/null; then yorha_say "shell restarting"
    else yorha_say "the shell is not running (start it with: $YORHA_CMD shell start)"; fi
}

# The shell's IPC, on the path of the version that is running (the supervisor writes it), so qs finds
# the instance even between an update's switch and the shell's restart.
cmd_ipc() {
    local root
    [[ -L $YORHA_HOME/current ]] || yorha_fail "not installed"
    root=$(cat "$(run_dir)/shell.root" 2>/dev/null || true)
    [[ -n $root && -d $root ]] || root=$(shell_root)
    exec qs -p "$root/shell" ipc call "$@"
}

# --- the optional core: boot and login (US5, research R10) ----------------------------------------
BOOT_LOGIN() { printf '%s/system/boot-login/%s-boot-login' "$(shell_root)" "$YORHA_NAME"; }

cmd_boot_login() {
    local sub=${1:-} mod
    mod=$(BOOT_LOGIN)
    [[ -x $mod ]] || yorha_fail "the boot and login module is not in this version"
    case $sub in
        status) exec sudo "$mod" status ;;
        install)
            yorha_say "the boot (Plymouth) and login (SDDM) themes change system files, with a backup of each;"
            yorha_say "this is what would change:"
            sudo "$mod" install --dry-run --src "$(shell_root)" || true
            yorha_ask "install them (sudo)?" || { yorha_say "nothing changed"; exit 1; }
            exec sudo "$mod" install --src "$(shell_root)" ;;
        uninstall)
            yorha_say "this is what would go back as it was:"
            sudo "$mod" uninstall --dry-run || true
            yorha_ask "undo the boot and login themes (sudo)?" || { yorha_say "nothing changed"; exit 1; }
            exec sudo "$mod" uninstall ;;
        *) usage ;;
    esac
}

# --- uninstall (US6, research R11) -------------------------------------------------------------------
cmd_uninstall() {
    local mod rd pid
    [[ -n $(yorha_current) ]] || yorha_fail "not installed"
    yorha_ask "remove $YORHA_PRETTY from $YORHA_HOME (the versions and the $YORHA_CMD command)?" \
        || { yorha_say "nothing removed"; exit 1; }
    mod=$(BOOT_LOGIN)
    if [[ -x $mod ]] && sudo -n true 2>/dev/null && sudo "$mod" status 2>/dev/null | grep -q 'installed.*yes'; then
        yorha_say "the boot and login themes are installed"
        if yorha_ask "undo them first (sudo)?"; then sudo "$mod" uninstall || yorha_say "the themes were not fully undone (see: sudo $mod status)"; fi
    elif [[ -x $mod ]]; then
        yorha_say "if you installed the boot and login themes, undo them first: $YORHA_CMD boot-login uninstall"
    fi
    rd=$(run_dir)
    pkill -f "[$(printf '%s' "${YORHA_CMD:0:1}")]${YORHA_CMD:1} shell start" 2>/dev/null || true
    pid=$(cat "$rd/shell.pid" 2>/dev/null || true)
    [[ -n $pid ]] && kill "$pid" 2>/dev/null || true
    rm -rf "$rd"
    rm -f "$YORHA_BIN/$YORHA_CMD"
    cd / && rm -rf "$YORHA_HOME"
    yorha_rename_forget             # spec 015: the alias, the links and the old name's folder
    if yorha_ask "also remove the saved state ($YORHA_STATE: what the menus saved, the update copies)?"; then
        rm -rf "$YORHA_STATE"
    fi
    yorha_say "$YORHA_PRETTY removed. Kept: $YORHA_CONFIG and the system packages it installed."
    yorha_say "remove its line from ~/.config/hypr/hyprland.lua (it does nothing now, but it is yours to clean)"
}

# The line the person adds at the top of ~/.config/hypr/hyprland.lua (contracts/encaixe.md).
include_line() {
    local f="$YORHA_HOME/current/system/hypr/$YORHA_NAME.lua"
    if [[ $f == "$HOME"/* ]]; then
        printf 'pcall(dofile, os.getenv("HOME") .. "%s")\n' "${f#"$HOME"}"
    else
        printf 'pcall(dofile, "%s")\n' "$f"
    fi
}

# Whether the person's hyprland.lua already has the include line (not commented out).
has_include_line() {
    local cfg=${XDG_CONFIG_HOME:-$HOME/.config}/hypr/hyprland.lua
    [[ -f $cfg ]] && grep -v '^[[:space:]]*--' "$cfg" | grep -qF "/current/system/hypr/$YORHA_NAME.lua"
}

# Called by install.sh from the freshly unpacked version: make it the one in use.
cmd__install() {
    local v
    v=$(yorha_version_of "$YORHA_ROOT")
    yorha_switch "$v"
    yorha_mark_migrations "$YORHA_ROOT"
    mkdir -p "$YORHA_STATE"
    echo "$v" > "$YORHA_STATE/last-version"
    yorha_say "$YORHA_PRETTY $v installed in $YORHA_HOME"
    if pgrep -x qs >/dev/null || pgrep -f serpantinumd >/dev/null; then
        yorha_say "another shell is running now; keep only one of them in your Hyprland autostart"
    fi
    case :$PATH: in *":$YORHA_BIN:"*) ;; *) yorha_say "add $YORHA_BIN to your PATH to run $YORHA_CMD" ;; esac
    # T029: the line may be there already (a reinstall, or added by hand first); it is Lua for
    # Hyprland, and people pasted it into the terminal, so say where it goes.
    if has_include_line; then
        cat <<DONE

Your ~/.config/hypr/hyprland.lua already loads $YORHA_PRETTY: log in again to start it.
To get newer versions later: $YORHA_CMD update
DONE
        return
    fi
    cat <<DONE

Last step: open ~/.config/hypr/hyprland.lua in a text editor, add this line at the top, save,
then log in again. It is Lua for Hyprland, not a terminal command:

    $(include_line)

It starts the shell and adds its keys (SUPER; set YORHA_MOD = "ALT" on the line before to change).
To get newer versions later: $YORHA_CMD update
DONE
}

main() {
    case ${1:-} in
        version) echo "$YORHA_NAME $(yorha_version_of "$YORHA_ROOT")" ;;
        status) cmd_status ;;
        _install) cmd__install ;;
        _finish-update) shift; cmd__finish_update "$@" ;;
        shell)
            case ${2:-} in
                start) shift 2; cmd_shell_start "$@" ;;
                restart) cmd_shell_restart ;;
                *) usage ;;
            esac ;;
        ipc) shift; (($#)) || usage; cmd_ipc "$@" ;;
        update) shift; cmd_update "$@" ;;
        rollback) cmd_rollback ;;
        migrate) shift; cmd_migrate "$@" ;;
        boot-login) shift; cmd_boot_login "$@" ;;
        uninstall) cmd_uninstall ;;
        *) usage ;;
    esac
}
main "$@"
