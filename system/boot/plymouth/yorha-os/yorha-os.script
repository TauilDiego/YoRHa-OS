# YoRHa-OS boot screen (spec 011): the system check list of the game's boot screen, written with
# the real boot stages and our own text. Numbers from the 4K analysis of the game's boot
# (YoRHa-OS-private/pessoal/referencias/jogo/boot-analise.md), in 1080p px, scaled by the screen's
# height. Layers, bottom to top:
#   content    the watermark, the header, the lines, the cursor and the loading ring (the only layer
#              the interference bands tear)
#   bands      interference bands: a patch of background, the torn content moved 3.5 px to the left,
#              the darkening and the faint rings
#   film       the LCD mesh (a tile), never torn
#   vignette   the side vignette
#   overlay    black: the fade in, the exit and the global flicker
# The lens (the red channel pulled towards the centre) is a red copy of each text, moved by its
# position on the screen; the glow is a blurred copy (scaled down and up again).
# In the shutdown and reboot modes (US5) only the passage band is shown, over black.
#
# Cost: each line is rendered once (the text, its red copy, its glow), a piece per frame before it
# starts, and typed by cropping that image at the letters' places (the font's advances come in the
# generated block). In the initramfs the label plugin is label-freetype, which draws only ASCII;
# after the switch to the real root it is label-pango. Boot texts stay ASCII.

# @generated-begin (gen/embed-stages.py, from config, stages.tsv and the font; do not edit by hand)
cfg_exit = "fast";
cfg_effects = "full";
cfg_typing = "instant";
cfg_debug = "off";
