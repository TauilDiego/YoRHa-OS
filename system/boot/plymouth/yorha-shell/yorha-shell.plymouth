[Plymouth Theme]
Name=YoRHa-Shell
Description=YoRHa-Shell boot screen: the system check list (spec 011)
ModuleName=script
# The boot font (assets/font, installed in the system fonts): the mkinitcpio hook copies it into the
# initramfs as Plymouth.ttf. The script asks for its own sizes.
Font=YoRHa-OS Boot 18

[script]
ImageDir=/usr/share/plymouth/themes/yorha-shell
ScriptFile=/usr/share/plymouth/themes/yorha-shell/yorha-shell.script
