# YoRHa-Shell boot sound (spec 013, contracts/boot-sound.md). Started by the udev rule when the card
# is ready, never ordered before anything and wanted by nothing else: the boot does not wait for it
# and a failure here costs nothing. Once per boot (the script leaves the .done file).
[Unit]
Description=YoRHa-Shell boot sound
ConditionPathExists=!/run/yorha-shell/boot-sound.done
ConditionPathExists=/usr/share/yorha-shell/boot/sound/yorha-boot-sound

[Service]
Type=simple
ExecStart=/usr/share/yorha-shell/boot/sound/yorha-boot-sound
RuntimeMaxSec=6
Nice=10
